{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "elixpo-opensource",
	"compatibility_date": "2024-04-01",
	"main": "./workers/app.ts",
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "elixpo_db",
			"database_id": "mock-db-id"
		}
	],
	"vars": {
		"VALUE_FROM_CLOUDFLARE": "Hello from Cloudflare"
	}
}
